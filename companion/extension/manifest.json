{
  "manifest_version": 3,
  "name": "Note Web Vim IME Companion",
  "version": "0.1.0",
  "description": "Bridges Web CodeMirror Vim mode with Windows Native IME companion for reliable modal input switching",
  "permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://notes.adcdxc.me/*",
    "http://localhost:3080/*",
    "http://localhost:5173/*",
    "http://127.0.0.1:3000/*",
    "http://127.0.0.1:3080/*",
    "http://127.0.0.1:5173/*"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://notes.adcdxc.me/*",
        "http://localhost:3080/*",
        "http://localhost:5173/*",
        "http://127.0.0.1:3000/*",
        "http://127.0.0.1:3080/*",
        "http://127.0.0.1:5173/*"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
